{% extends 'base.html.twig' %}

{% block title %}PdfReader — коди з PDF і архів сторінок{% endblock %}

{% block body %}
<div class="page">
    <header class="top">
        <a class="brand-mark" href="{{ path('home') }}" aria-label="PdfReader home">PdfReader</a>
        <nav class="top-nav" aria-label="Primary">
            <a href="#capabilities">Можливості</a>
            <a href="#api">API</a>
        </nav>
    </header>

    <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
            <p class="brand-hero">PdfReader</p>
            <h1 id="hero-heading">Зчитуємо коди з PDF. Ділимо документ на сторінки.</h1>
            <p class="hero-lead">API для витягування QR і штрихкодів з PDF-файлів та пакування кожної сторінки в окремий архів для завантаження.</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#api">Дивитись API</a>
                <a class="btn btn-ghost" href="#capabilities">Як це працює</a>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="scan-beam"></div>
            <svg class="hero-art" viewBox="0 0 720 520" role="img">
                <defs>
                    <linearGradient id="sheet" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#f7f1e6"/>
                        <stop offset="100%" stop-color="#e4d7c4"/>
                    </linearGradient>
                    <linearGradient id="ink" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#1c3329"/>
                        <stop offset="100%" stop-color="#0f1f18"/>
                    </linearGradient>
                    <filter id="soft" x="-10%" y="-10%" width="120%" height="120%">
                        <feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#152820" flood-opacity="0.18"/>
                    </filter>
                </defs>

                <rect class="sheet sheet-back" x="170" y="70" width="340" height="420" rx="18" fill="url(#sheet)" filter="url(#soft)" transform="rotate(-8 340 280)"/>
                <rect class="sheet sheet-mid" x="210" y="58" width="340" height="420" rx="18" fill="url(#sheet)" filter="url(#soft)" transform="rotate(4 380 268)"/>
                <g class="sheet sheet-front" filter="url(#soft)">
                    <rect x="250" y="46" width="340" height="420" rx="18" fill="url(#sheet)"/>
                    <rect x="278" y="86" width="180" height="14" rx="7" fill="#c9baa4"/>
                    <rect x="278" y="116" width="260" height="10" rx="5" fill="#d7cab8"/>
                    <rect x="278" y="138" width="220" height="10" rx="5" fill="#d7cab8"/>
                    <rect x="278" y="160" width="240" height="10" rx="5" fill="#d7cab8"/>
                    <g class="barcode" transform="translate(292 220)">
                        <rect width="8" height="120" fill="url(#ink)"/>
                        <rect x="14" width="4" height="120" fill="url(#ink)"/>
                        <rect x="24" width="10" height="120" fill="url(#ink)"/>
                        <rect x="40" width="3" height="120" fill="url(#ink)"/>
                        <rect x="50" width="12" height="120" fill="url(#ink)"/>
                        <rect x="68" width="5" height="120" fill="url(#ink)"/>
                        <rect x="80" width="9" height="120" fill="url(#ink)"/>
                        <rect x="96" width="3" height="120" fill="url(#ink)"/>
                        <rect x="106" width="11" height="120" fill="url(#ink)"/>
                        <rect x="124" width="4" height="120" fill="url(#ink)"/>
                        <rect x="136" width="8" height="120" fill="url(#ink)"/>
                        <rect x="150" width="3" height="120" fill="url(#ink)"/>
                        <rect x="160" width="10" height="120" fill="url(#ink)"/>
                        <rect x="176" width="5" height="120" fill="url(#ink)"/>
                        <rect x="188" width="7" height="120" fill="url(#ink)"/>
                        <rect x="202" width="4" height="120" fill="url(#ink)"/>
                        <rect x="214" width="12" height="120" fill="url(#ink)"/>
                    </g>
                    <g class="qr" transform="translate(478 238)">
                        <rect width="78" height="78" rx="6" fill="url(#ink)"/>
                        <rect x="10" y="10" width="22" height="22" fill="#f2ebe0"/>
                        <rect x="46" y="10" width="22" height="22" fill="#f2ebe0"/>
                        <rect x="10" y="46" width="22" height="22" fill="#f2ebe0"/>
                        <rect x="16" y="16" width="10" height="10" fill="url(#ink)"/>
                        <rect x="52" y="16" width="10" height="10" fill="url(#ink)"/>
                        <rect x="16" y="52" width="10" height="10" fill="url(#ink)"/>
                        <rect x="40" y="40" width="8" height="8" fill="#f2ebe0"/>
                        <rect x="52" y="52" width="6" height="6" fill="#f2ebe0"/>
                        <rect x="40" y="58" width="6" height="6" fill="#f2ebe0"/>
                    </g>
                    <rect x="278" y="380" width="200" height="10" rx="5" fill="#d7cab8"/>
                    <rect x="278" y="402" width="150" height="10" rx="5" fill="#d7cab8"/>
                </g>
            </svg>
        </div>
    </section>

    <section class="capability" id="capabilities" aria-labelledby="cap-codes">
        <div class="capability-copy">
            <p class="eyebrow">Можливість 01</p>
            <h2 id="cap-codes">QR і штрихкоди з будь-якого PDF</h2>
            <p>Надсилаєте PDF через API — отримуєте список знайдених кодів: сторінка, тип і значення. Підходять квитки, ваучери, етикетки та скановані документи.</p>
        </div>
        <div class="capability-panel panel-codes" aria-hidden="true">
            <pre class="code-sample">{
  "count": 2,
  "codes": [
    { "page": 1, "type": "QR-Code", "data": "…" },
    { "page": 2, "type": "I2/5", "data": "…" }
  ]
}</pre>
        </div>
    </section>

    <section class="capability capability-alt" aria-labelledby="cap-split">
        <div class="capability-panel panel-split" aria-hidden="true">
            <div class="split-stack">
                <span>page_0001.pdf</span>
                <span>page_0002.pdf</span>
                <span>page_0003.pdf</span>
                <strong>pages.zip</strong>
            </div>
        </div>
        <div class="capability-copy">
            <p class="eyebrow">Можливість 02</p>
            <h2 id="cap-split">Кожна сторінка — окремий файл</h2>
            <p>Завантажуєте багатосторінковий PDF і отримуєте посилання на ZIP-архів, де кожна сторінка збережена окремо — зручно для масової обробки й перевірок.</p>
        </div>
    </section>

    <section class="api" id="api" aria-labelledby="api-heading">
        <p class="eyebrow">Доступ</p>
        <h2 id="api-heading">Дві захищені точки API</h2>
        <p class="api-lead">Усі запити перевіряють access token з конфігурації сервера.</p>

        <div class="api-grid">
            <article>
                <h3><code>POST /api/pdf/codes</code></h3>
                <p>Приймає PDF, повертає знайдені QR і barcode.</p>
            </article>
            <article>
                <h3><code>POST /api/pdf/split</code></h3>
                <p>Приймає PDF, повертає URL для завантаження ZIP зі сторінками.</p>
            </article>
        </div>
    </section>

    <footer class="foot">
        <span class="brand-mark">PdfReader</span>
        <span>PHP 8.2 · Symfony · Token-protected API</span>
    </footer>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/landing.js') }}" defer></script>
{% endblock %}
